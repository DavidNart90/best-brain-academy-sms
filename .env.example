# Copy to .env.local only after confirming the school target.
# Both values are public. Never put sb_secret_* or service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Integration tests only. D-01 currently authorizes the app project as test-only.
# Also match tests/fixtures/supabase-target.json; disable it before production use.
# TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
# TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TEST_PUBLIC_KEY
# TEST_SUPABASE_PROJECT_REF=YOUR_TEST_PROJECT_REF
# TEST_TARGET_ACK=isolated-test-only
# TEST_ALLOWED_EMAIL=phase0-allowed@example.invalid
# TEST_ALLOWED_PASSWORD=SET_LOCALLY
# TEST_DENIED_EMAIL=phase0-denied@example.invalid
# TEST_DENIED_PASSWORD=SET_LOCALLY
# TEST_DISABLED_EMAIL=phase0-disabled@example.invalid
# TEST_DISABLED_PASSWORD=SET_LOCALLY
